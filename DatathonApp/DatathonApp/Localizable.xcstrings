    "%@ would like to send you appointment details and reminders in MyMob.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦%@ wóúld líké tó séñd ýóú áppóíñtméñt détáíls áñd rémíñdérs íñ MýMób.⟧"
          }
