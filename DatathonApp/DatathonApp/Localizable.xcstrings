    "Aboriginal and Torres Strait Islander people are advised that this post may contain images, voices or names of people who have died.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Ábórígíñál áñd Tórrés Stráít Ísláñdér péóplé áré ádvíséd thát thís póst máý çóñtáíñ ímágés, vóíçés ór ñámés óf péóplé whó hávé díéd.⟧"
          }
        }
      }
    },
    "Accept": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
