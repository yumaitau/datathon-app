    "Language custodians draft translations of your community's languages. Elders approve them before anyone sees them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Láñgúágé çústódíáñs dráft tráñslátíóñs óf ýóúr çómmúñítý's láñgúágés. Éldérs áppróvé thém béfóré áñýóñé séés thém.⟧"
          }
        }
      }
    },
    "Make language custodian": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Máké láñgúágé çústódíáñ⟧"
          }
        }
      }
    },
    "Managing members needs normal coverage.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Máñágíñg mémbérs ñééds ñórmál çóvérágé.⟧"
          }
        }
      }
    },
    "Remove this person from the group?": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Rémóvé thís pérsóñ fróm thé gróúp?⟧"
          }
        }
      }
    },
    "Search members": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
