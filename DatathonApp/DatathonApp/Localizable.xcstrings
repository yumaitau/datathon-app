        }
      }
    },
    "They stop seeing %@. They can ask to join again.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⟦Théý stóp sééíñg %@. Théý çáñ ásk tó jóíñ ágáíñ.⟧"
          }
        }
      }
    },
